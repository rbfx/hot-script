using "Urho3D/Core/Context.h";
using "Urho3D/Scene/LogicComponent.h";
using "Urho3D/Scene/Node.h";

[ReflectedObject]
class Rotator : Urho3D.LogicComponent {
    float speed = 90.0f;

    Rotator(Urho3D.Context* context) : base(context) {
    }

    override void Update(float timeStep) {
        Urho3D.Node* node = GetNode();
        if (node != null) {
            node.Rotate(Urho3D.Quaternion(
                speed * timeStep,
                speed * timeStep,
                0.0f), Urho3D.TS_LOCAL);
        }
    }
}
